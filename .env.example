# ============================================================
# 优益C 热点策略智能体 - 环境变量配置
# 复制本文件为 .env，填入真实值即可（.env 不会被上传到 GitHub）
# ============================================================

# ---- 火山方舟 · 豆包大模型（必填）----
# 获取地址：https://console.volcengine.com/ark/region:ark+cn-beijing/apiKey
ARK_API_KEY=在此填入你的火山方舟APIKey
# 模型/接入点 ID（在火山方舟「在线推理」创建接入点后获得，形如 ep-2026xxxx）
# 也可直接填模型名，如 doubao-seed-1-6-250615（需方舟支持按模型名调用）
ARK_MODEL=在此填入模型或接入点ID
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ---- Embedding 向量化（可选，不填则用本地 BM25 关键词检索）----
ARK_EMBED_MODEL=

# ---- 热点搜索（可选，不填默认用免费 DuckDuckGo）----
# Tavily 免费 Key：https://tavily.com（每月1000次）
TAVILY_API_KEY=
# 博查 Bocha 国内搜索 Key（可选）：https://open.bochaai.com
BOCHA_API_KEY=

# ---- 服务配置 ----
# 后端端口
API_PORT=8000
# 每日每设备免费体验对话上限（保护额度，0 表示不限制）
DAILY_TRIAL_LIMIT=8
